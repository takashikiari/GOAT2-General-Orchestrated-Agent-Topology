# Copy this file to .env and fill in real values. Never commit .env.
#
# Model and per-role behaviour is configured in config/agents.toml (non-secret).
# Only secrets and infrastructure endpoints belong here.

# ── Required ──────────────────────────────────────────────────────────────────

# API key for your LLM provider — variable name follows the pattern:
# GOAT_{PROVIDER}_API_KEY  where provider is: openai | deepseek | groq
# Add one line per provider you use.
# GOAT_OPENAI_API_KEY=
# GOAT_DEEPSEEK_API_KEY=
# Deepgram for the admin panel voice features: speech-to-text (push-to-talk and the live conversation mode, Nova-3) and
# GOAT's spoken replies (Flux TTS, Romanian). Without it the voice button answers an explicit stub and the conversation
# speaks with the browser's own voice. Optional: DEEPGRAM_MODEL (default nova-3), DEEPGRAM_LANGUAGE (ro),
# DEEPGRAM_TTS_MODEL (default flux-ioana-ro; flux-cosmin-ro is the male voice), DEEPGRAM_TTS=off (browser voice only).
# DEEPGRAM_API_KEY=
# The panel's live speech-to-speech voice ("Voice: Live" in the chat): VOICE_LIVE_PROVIDER=gemini with a Gemini API key.
# Without both, the option does not appear. Optional: VOICE_LIVE_VOICE (a Gemini voice name, e.g. Charon, Puck, Kore),
# GEMINI_LIVE_MODEL (default gemini-3.8-live). Use a PAID Gemini tier: the free tier may train on the audio.
# VOICE_LIVE_DAILY_MINUTES (default 60): hard daily cap on live voice minutes (it is billed by the minute); once it is used
# up the chat talks with the Deepgram voice until the next day. The count is shown on the Dashboard and kept in
# VOICE_LIVE_USAGE_FILE (default ~/.local/state/goat2/voice_live_usage.json; not under ~/.cache, cleared nightly here).
# VOICE_LIVE_PROVIDER=
# GEMINI_API_KEY=
# OpenAI Realtime instead (or for the A/B, scripts/voice_live_ab.py): VOICE_LIVE_PROVIDER=openai with an OpenAI key.
# Optional: OPENAI_REALTIME_MODEL (default gpt-realtime-2), VOICE_LIVE_VOICE (an OpenAI voice, e.g. marin, cedar).
# Romanian is not on OpenAI's published list for this model; the A/B by ear decides.
# OPENAI_API_KEY=
# GOAT_GROQ_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# ── Optional overrides ────────────────────────────────────────────────────────

# TIMEOUT_SECONDS=30
# MAX_TOKENS=2048

# DAG sandbox workspace directory
# DAG_WORKSPACE=/path/to/dag_workspace

# Suppress HuggingFace unauthenticated requests warning (no token needed)
# HF_HUB_DISABLE_WARNINGS=1
