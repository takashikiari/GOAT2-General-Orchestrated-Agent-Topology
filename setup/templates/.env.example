# GOAT 2.0 — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env in the project root and fill in your values.
# Never commit .env to git — it contains your private keys.
#
# How to copy:
#   cp setup/templates/.env.example .env
#
# The names below are the ones GOAT reads (config/settings.py); the setup wizard writes the same ones
# (setup/env_writer.py, checked by tests/test_setup_env_contract.py).
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram (required) ───────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get this token.
TELEGRAM_BOT_TOKEN=

# ── LLM Providers ─────────────────────────────────────────────────────────────
# GOAT runs with one of: DeepSeek, OpenAI, Groq. Fill in the key of the one you use.
GOAT_DEEPSEEK_API_KEY=
GOAT_OPENAI_API_KEY=
GOAT_GROQ_API_KEY=

# Which provider and model GOAT talks to (the wizard sets both for the provider you choose as default).
# Without them GOAT uses DeepSeek (https://api.deepseek.com) and the model in config/agents.toml.
# BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash

# ── Admin panel (optional) ────────────────────────────────────────────────────
# true opens a Cloudflare tunnel at start so the panel works as a Telegram Mini App (reachable from the internet,
# gated by Telegram auth). Overrides [tunnel] enabled in config/admin_panel.toml; off when unset.
# ADMIN_PANEL_TUNNEL=true

# ── Services (optional) ───────────────────────────────────────────────────────
# Redis and Letta addresses are read from config/memory.toml ([working] storage_url, [permanent] letta_url),
# not from this file. Defaults: redis://localhost:6379/0 and http://localhost:8283.
